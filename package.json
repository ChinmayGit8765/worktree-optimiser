{
  "name": "worktree-optimiser",
  "version": "0.1.0",
  "type": "module",
  "description": "Run every git worktree of a repo as its own containerised dev server, behind one dashboard.",
  "license": "MIT",
  "author": "Chinmay Purohit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChinmayGit8765/worktree-optimiser.git"
  },
  "keywords": [
    "git-worktree",
    "docker",
    "traefik",
    "developer-tools",
    "claude-code",
    "mcp"
  ],
  "workspaces": [
    "apps/manager",
    "apps/web",
    "apps/mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/manager",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/manager && npm run build --workspace apps/mcp",
    "start": "npm run start --workspace apps/manager",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/manager",
    "test:integration": "npm run test:integration --workspace apps/manager",
    "doctor": "node apps/manager/dist/doctor-cli.js",
    "mcp": "node apps/mcp/dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "bin": {
    "worktree-optimiser": "bin/worktree-optimiser.js"
  },
  "files": [
    "bin/",
    "apps/manager/dist/",
    "apps/manager/public/",
    "apps/mcp/dist/",
    "docker/",
    ".env.example",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dockerode": "^4.0.4",
    "fastify": "^5.2.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  }
}
