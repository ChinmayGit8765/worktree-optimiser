# Copy to .env and adjust. Every value here is optional.
#
# The manager reads .env from the working directory, falling back to the repo
# root. A real environment variable always wins over the file, so
# `WT_HTTP_PORT=8080 npm start` still overrides what is set here.

# Manager API + dashboard
WT_PORT=7777

# --- Network exposure -------------------------------------------------------
# The manager deletes directories on this host and serves file contents from any
# registered repo, so it binds loopback only. Setting WT_HOST to a routable
# interface REQUIRES WT_TOKEN; the process refuses to start otherwise.
# WT_HOST=127.0.0.1
# WT_TOKEN=

# Interface Traefik publishes worktree ports on. Set to 0.0.0.0 to test a
# worktree from a phone on your LAN -- that exposes every running dev server.
# WT_HTTP_BIND=127.0.0.1

# Extra Host header values to accept (DNS-rebinding guard) and extra browser
# origins allowed to read API responses. Comma-separated.
# WT_ALLOWED_HOSTS=
# WT_ALLOWED_ORIGINS=

# Host port Traefik listens on. Set to 8080 if something already owns 80;
# worktree URLs then become http://<slug>.localhost:8080
WT_HTTP_PORT=80
WT_TRAEFIK_DASHBOARD_PORT=8088

# Wildcard domains. Browsers resolve *.localhost to loopback automatically;
# *.localtest.me does the same via public DNS for non-browser clients.
WT_DOMAIN=localhost
WT_ALT_DOMAIN=localtest.me

WT_NETWORK=wt-net
WT_TRAEFIK_IMAGE=traefik:v3.3

# --- Direct per-worktree ports ----------------------------------------------
# Each worktree also gets a plain http://127.0.0.1:<port> URL, so a worktree is
# reachable even when hostname resolution or the proxy is the thing that broke.
# Set WT_PORT_FALLBACK=false to publish nothing but the hostnames.
# WT_PORT_FALLBACK=true
# WT_PORT_RANGE=31000-31999

# --- Resource caps ----------------------------------------------------------
# Applied to every worktree container, so a dozen bundlers cannot take the
# machine down. 0 disables either cap.
# WT_DEFAULT_CPUS=2
# WT_DEFAULT_MEMORY_MB=4096

# Stop a worktree after this many minutes with no requests through the proxy.
# 0 is off. It only ever stops the container -- the worktree, its branch and its
# dependency volumes are untouched.
# WT_IDLE_STOP_MINUTES=0

# Where the project registry is written
WT_DATA_DIR=./data

# Bind path conversion: win | wsl | unix. Auto-detected from the platform.
# WT_BIND_STYLE=win

# Override the Docker socket if you're not on the default context.
# WT_DOCKER_SOCKET=//./pipe/docker_engine

WT_LOG_LEVEL=info

# --- MCP server -------------------------------------------------------------
# Read by the MCP process, which is launched by your agent client rather than by
# the manager -- so set these in the client's MCP config, not here. Listed for
# reference. See docs/mcp.md.
# WT_MANAGER_URL=http://127.0.0.1:7777
# WT_MCP_ALLOW_DESTRUCTIVE=false
